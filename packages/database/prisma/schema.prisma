generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model DealHeader {
  dealID       Int       @id
  dtRegistered DateTime? @db.Date
  expiration   String?   @db.VarChar(50)
  expDt        DateTime? @db.Date
  brand        String?   @db.VarChar(50)
  customerID   Int?
  dealRegID    String?   @unique @db.VarChar(50)
  ProjectName  String?   @db.VarChar(Max)
  AssignedAO   String?   @db.VarChar(50)
  BU           String?   @db.VarChar(50)
  dealStatus   String?   @db.VarChar(Max)
  dtCreated    DateTime? @db.DateTime
  dtValidTo    DateTime? @db.DateTime
  createdBy    String?   @db.VarChar(50)
  custName     String?   @db.VarChar(Max)
  remarks      String?   @db.VarChar(Max)

  DealItems    DealItems[]
  DealWTN      dealWTN?
  DealResponse DealResponse?
  DealLost     DealLost?
  Renewals     DealRenewal[]
  PreviousLink DealLinks?    @relation("DealLinks_Current")
  NextLinks    DealLinks[]   @relation("DealLinks_Previous")

  @@index([AssignedAO, dtCreated])
  @@index([BU, dtCreated])
  @@index([dtCreated])
  @@index([customerID])
  @@index([brand, dtCreated])
  @@index([expDt])
}

model DealItems {
  dealItemID Int     @id
  dealID     Int?
  itemDesc   String? @db.VarChar(Max)
  qty        String? @db.VarChar(50)
  currency   String? @db.VarChar(50)
  totalAmt   String? @db.VarChar(50)

  DealHeader DealHeader? @relation(fields: [dealID], references: [dealID], onDelete: Cascade)

  @@index([dealID])
}

model DealResponse {
  id           Int     @id
  dealID       Int?    @unique
  responseDays String? @db.VarChar(50)

  DealHeader   DealHeader? @relation(fields: [dealID], references: [dealID], onDelete: Cascade)
}

model DealLost {
  dealID           Int     @id
  competitorVendor String? @db.VarChar(200)
  competitorBrand  String? @db.VarChar(200)
  icsOffer         String? @db.VarChar(150)
  competitorOffer  String? @db.VarChar(150)
  reason           String? @db.VarChar(250)
  otherInformation String? @db.VarChar(250)

  DealHeader       DealHeader @relation(fields: [dealID], references: [dealID], onDelete: Cascade)
}

model cdbAccounts {
  AccountID      Int       @id
  AccountIDNo    String    @db.NVarChar(100)
  AONumber       Int
  AccountName    String    @db.NVarChar(600)
  AccountGroup   String    @db.NVarChar(100)
  AccountType    String    @db.NVarChar(30)
  DomainAccount  String    @db.NVarChar(100)
  Email          String    @db.VarChar(30)
  ValidTo        DateTime? @db.DateTime
  SignaturePath  String?   @db.VarChar(500)
  SignatureImage Bytes?
  NickName       String?   @db.VarChar(50)
  isActive       Int?
  GAvatar        String?   @db.VarChar(Max)

  @@index([AccountName])
  @@index([AccountIDNo])
  @@index([AccountGroup])
  @@index([DomainAccount])
  @@index([Email])
}

model DealBrands {
  id         Int     @id
  brand      String? @db.VarChar(50)
  assignedPM String? @db.VarChar(50)
}

model deals_reg_notification {
  email_id    Int       @id
  creator     String?   @db.VarChar(Max)
  subject     String?   @db.VarChar(Max)
  message     String?   @db.VarChar(Max)
  sendTo      String?   @db.VarChar(Max)
  sendCC      String?   @db.VarChar(Max)
  sendBCC     String?   @db.VarChar(Max)
  dateCreated DateTime? @db.DateTime
  status      Int       @default(0)
  dateSent    DateTime? @db.DateTime

  @@index([status, dateCreated])
}

model DealStatus {
  status_id  Int     @id
  statusDesc String? @db.VarChar(50)
}

model dealWTN {
  id           Int       @id
  whenToNotify DateTime? @db.DateTime
  dealID       Int?      @unique

  DealHeader   DealHeader? @relation(fields: [dealID], references: [dealID], onDelete: Cascade)

  @@index([dealID])
  @@index([whenToNotify])
}

model Users {
  AccountID        Int       @id
  AccountName      String    @db.NVarChar(600)
  Email            String    @unique @db.VarChar(255)
  UserRole         String    @db.VarChar(50)
  AssignedBU       String?   @db.NVarChar(500)
  AssignedBrand    String?   @db.NVarChar(500)
  HasCompletedTour Boolean?  @default(false)
  RememberToken    String?   @db.VarChar(Max)
  DtCreation       DateTime  @default(now()) @db.DateTime
  LastLogin        DateTime? @db.DateTime

  @@index([AccountName])
  @@index([Email])
}

model DealRenewal {
  renewalID    Int       @id
  dealID       Int
  dtRenewal    DateTime? @db.Date
  rexpDt       DateTime? @db.Date
  remarks      String?   @db.VarChar(Max)
  dtCreated    DateTime? @default(now()) @db.DateTime

  DealHeader   DealHeader @relation(fields: [dealID], references: [dealID], onDelete: Cascade)

  @@index([dealID])
  @@index([dtRenewal])
}

model ActivityLogs {
  logID           Int       @id
  dealID          Int?
  dealRegID       String?   @db.VarChar(50)
  custName        String?   @db.NVarChar(Max)
  projectName     String?   @db.NVarChar(Max)
  action          String    @db.VarChar(50)
  fieldName       String?   @db.VarChar(100)
  oldValue        String?   @db.NVarChar(Max)
  newValue        String?   @db.NVarChar(Max)
  remarks         String?   @db.NVarChar(Max)
  performedBy     String    @db.VarChar(100)
  performedByName String?   @db.NVarChar(200)
  performedByRole String?   @db.VarChar(50)
  impersonatedBy  String?   @db.VarChar(100)
  dtCreated       DateTime  @default(now()) @db.DateTime

  @@index([dtCreated])
  @@index([dealID])
  @@index([dealRegID])
  @@index([action])
  @@index([performedBy])
  @@map("activity_logs")
}

model DealLinks {
  id             Int       @id
  dealID         Int       @unique
  previousDealID Int
  dtCreated      DateTime? @default(now()) @db.DateTime

  CurrentDeal    DealHeader @relation("DealLinks_Current", fields: [dealID], references: [dealID], onDelete: Cascade)
  PreviousDeal   DealHeader @relation("DealLinks_Previous", fields: [previousDealID], references: [dealID], onUpdate: NoAction, onDelete: NoAction)

  @@index([dealID])
  @@index([previousDealID])
  @@map("DealLinks")
}

view DealReportView {
  dealID            Int       @id
  dealRegID         String?   @db.VarChar(50)
  custName          String?   @db.VarChar(Max)
  ProjectName       String?   @db.VarChar(Max)
  brand             String?   @db.VarChar(50)
  BU                String?   @db.VarChar(50)
  AssignedAO        String?   @db.VarChar(50)
  dealStatus        String?   @db.VarChar(Max)
  dtRegistered      DateTime? @db.Date
  expDt             DateTime? @db.Date
  dtCreated         DateTime? @db.DateTime
  createdBy         String?   @db.VarChar(50)
  remarks           String?   @db.VarChar(Max)
  assignedPM        String?   @db.VarChar(50)
  TotalAmount       Decimal?  @db.Decimal(18, 2)
  ItemCount         Int?
  IsRenewed         Int?
  RenewalCount      Int?
  LatestRenewalDate DateTime? @db.Date
  IsLost            Int?
  competitorVendor  String?   @db.VarChar(200)
  competitorBrand   String?   @db.VarChar(200)
  LostReason        String?   @db.VarChar(250)
  DaysRemaining     Int?
  IsExpired         Int?

  @@map("DealReportView")
}

