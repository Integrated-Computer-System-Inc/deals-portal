{
  "name": "deals-registration-portal-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run db:generate && turbo run build",
    "dev": "turbo run dev",
    "start": "npm run --prefix apps/deals start",
    "lint": "turbo run lint",
    "db:generate": "npm run --prefix packages/database generate",
    "db:push": "npm run --prefix packages/database db:push"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "swr": "^2.5.1"
  }
}
